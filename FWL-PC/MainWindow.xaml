<Window x:Class="FwlPc.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FWL PC — Website Firewall"
        Width="820" Height="640" MinWidth="720" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource PageBackground}">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,20">
            <StackPanel Orientation="Horizontal">
                <Border Width="48" Height="48" Background="#16A34A" CornerRadius="14" Margin="0,0,14,0">
                    <TextBlock Text="✓" Foreground="White" FontSize="26" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="FWL PC" Foreground="{StaticResource TextPrimary}" FontSize="28" FontWeight="Bold"/>
                    <TextBlock Text="Allow-list firewall for Chrome, Edge and Opera" Foreground="{StaticResource TextSecondary}" FontSize="13"/>
                </StackPanel>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" CornerRadius="16" Padding="18" Margin="0,0,0,18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="StatusDot" Width="10" Height="10" Fill="#EF4444" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="StatusText" Text="Protection OFF" Foreground="{StaticResource TextPrimary}" FontSize="16" FontWeight="SemiBold"/>
                    </StackPanel>
                    <TextBlock Text="When enabled, websites are blocked by browser policy unless they are on your allow list." Foreground="{StaticResource TextSecondary}" Margin="18,6,0,0" TextWrapping="Wrap"/>
                </StackPanel>
                <Button x:Name="ToggleButton" Grid.Column="1" Content="Enable protection" Background="#16A34A" Click="ToggleProtection_Click" Padding="18,12"/>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Allowed websites" Foreground="{StaticResource TextPrimary}" FontSize="18" FontWeight="Bold"/>
            <TextBlock Grid.Row="1" Text="Add a domain such as google.com. Subdomains are allowed automatically." Foreground="{StaticResource TextSecondary}" Margin="0,6,0,14"/>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ListBox x:Name="AllowedSitesList" Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" Foreground="{StaticResource TextPrimary}" FontSize="14" Padding="6"/>
                <StackPanel Grid.Column="1" Margin="14,0,0,0">
                    <TextBox x:Name="SiteTextBox" Width="270" Height="42" ToolTip="example.com"/>
                    <Button Content="Add website" Background="#2563EB" Margin="0,10,0,8" Click="AddSite_Click"/>
                    <Button Content="Remove selected" Background="#334155" Click="RemoveSite_Click"/>
                </StackPanel>
            </Grid>

            <TextBlock Grid.Row="3" x:Name="HintText" Foreground="{StaticResource TextSecondary}" Margin="0,14,0,0" TextWrapping="Wrap"/>
        </Grid>

        <Border Grid.Row="3" Background="#0F172A" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,18,0,0">
            <TextBlock Foreground="{StaticResource TextSecondary}" FontSize="12" TextWrapping="Wrap"><Run Text="Admin permission is required because Windows browser policies are stored under the machine policy registry. "/><Run Text="Disable protection" TextDecorations="Underline"/><Run Text=" restores the policy values saved before FWL PC took control."/></TextBlock>
        </Border>
    </Grid>
</Window>
